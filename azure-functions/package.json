{
  "name": "audiosen-email-outbox-function",
  "version": "1.0.0",
  "private": true,
  "description": "Timer-triggered Azure Function adapter for Audiosen's transactional email outbox.",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "contract:check": "node scripts/check-shared-contract.mjs",
    "prisma:generate": "node scripts/generate-prisma-client.mjs",
    "build": "npm run contract:check && npm run prisma:generate && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.spec.ts",
    "verify": "npm run build && npm run typecheck && npm test",
    "deploy:check": "node scripts/check-deploy-platform.mjs",
    "start": "func start"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.1",
    "@prisma/client": "6.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "esbuild": "^0.28.2",
    "prisma": "6.12.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
