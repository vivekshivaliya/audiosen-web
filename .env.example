SMTP_HOST=smtp.azurecomm.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_azure_communication_services_smtp_username
SMTP_PASS=your_entra_application_client_secret_value
MAIL_FROM=Audiosen Support <support@audiosen.com>
MAIL_TO=your_verified_forwarding_inbox@example.com

# Durable website lead storage (production uses App Service managed identity).
AZURE_TABLES_ENDPOINT=https://your_storage_account.table.core.windows.net
AZURE_TABLE_NAME=AudiosenLeads
# Local development alternative only (for example, Azurite). Never use this in production.
AZURE_TABLES_CONNECTION_STRING=

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
