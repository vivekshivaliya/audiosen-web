# Azure Communication Services Email. The HTTPS endpoint uses managed identity.
AZURE_COMMUNICATION_EMAIL_ENDPOINT=https://your-resource.communication.azure.com
# Optional local/emergency fallback; load from a secret store and leave blank when managed identity is available.
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=
# Provider-verified outbound sender only; public contact and reply-to use contactaudiosen@gmail.com.
AZURE_COMMUNICATION_EMAIL_SENDER=support@audiosen.com
# Optional when the deployment uses a user-assigned managed identity.
AZURE_CLIENT_ID=

# SMTP fallback used automatically if Azure Communication Services Email is unavailable.
# For Gmail, use a Google App Password, never an account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Provider-approved fallback sender only; do not set this to the public Gmail address unless verified by SMTP.
EMAIL_FROM=support@audiosen.com
ADMIN_EMAIL=vivekshivaliya10@gmail.com

# Optional official patient confirmations. Missing account approval, credentials, or an approved
# WhatsApp template leaves delivery disabled without affecting a valid enquiry.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional privacy-limited Google Analytics. Leave blank to keep analytics disabled.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Durable website lead storage (production uses App Service managed identity).
AZURE_TABLES_ENDPOINT=https://your_storage_account.table.core.windows.net
AZURE_TABLE_NAME=AudiosenLeads
# Local development alternative only (for example, Azurite). Never use this in production.
AZURE_TABLES_CONNECTION_STRING=

# PostgreSQL is the production source of truth for enquiries, admin, products, offers, and sync.
DATABASE_URL=postgresql://audiosen:replace_me@your-postgres-host:5432/audiosen?sslmode=require

# Google allowlisted admin authentication. Generate a high-entropy AUTH_SECRET; never commit it.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL_ALLOWLIST=vivekshivaliya10@gmail.com
ADMIN_OWNER_EMAIL=vivekshivaliya10@gmail.com
AUTH_TRUST_HOST=true

# Separate owner-only Google Business Profile OAuth (read-only V1). Do not reuse the admin client.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=https://audiosen.com/api/admin/google-business/callback
GOOGLE_BUSINESS_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Local development only: base64-encoded 32-byte AES key. Rejected in production.
GOOGLE_BUSINESS_TOKEN_KEY=

# AES-256-GCM enquiry narrative encryption. Value is a base64-encoded 32-byte key.
ENQUIRY_FIELD_ENCRYPTION_KEY_VERSION=v1
ENQUIRY_FIELD_ENCRYPTION_KEY=
# Rotation alternative: JSON map such as {"v1":"base64-key","v2":"base64-key"}.
ENQUIRY_FIELD_ENCRYPTION_KEYS=
IP_HASH_SECRET=
THANK_YOU_CONTEXT_SECRET=

# Cloudflare Turnstile. Production public enquiries fail closed without these keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_ACTION=enquiry_submit
TURNSTILE_ALLOWED_HOSTNAMES=audiosen.com,www.audiosen.com
# Independent HMAC key (at least 32 high-entropy bytes) for 30-minute upload verification grants.
UPLOAD_VERIFICATION_GRANT_SECRET=
PUBLIC_ENQUIRIES_ENABLED=true

# Server-side legal publication switch. Keep false until counsel/Owner approval is recorded.
LEGAL_CONTENT_APPROVED=false

# Staged 34-model guidance routes stay unavailable until owner/source/media gates pass.
# Enable only in a private Azure staging slot for content review.
CATALOG_STAGING_PREVIEW_ENABLED=false
# Independent production switch. It still fails closed unless the complete six-brand database,
# source, product, and rights-cleared media snapshot passes every server-side gate.
CATALOG_PUBLICATION_ENABLED=false

# Azure deployment-slot safeguard. This permits only the exact configured
# azurewebsites.net slot host and forces site-wide noindex with analytics disabled.
AUDIOSEN_STAGING_DEPLOYMENT=false
AUDIOSEN_STAGING_HOST=your-exact-seo-staging-slot-default-hostname.azurewebsites.net

# Protected deployment-readiness probe and Azure Function dependency.
READINESS_PROBE_SECRET=
EMAIL_OUTBOX_WORKER_READINESS_URL=https://your-function.azurewebsites.net/api/health/outbox/readiness
EMAIL_OUTBOX_WORKER_READINESS_KEY=

# Existing public product-media container; never reuse or auto-create the private intake container.
AZURE_PRODUCT_MEDIA_CONTAINER=audiosen-product-media
# Exact credential-free HTTPS Blob/CDN base used only behind opaque /catalog-media/<uuid> URLs.
CATALOG_PUBLIC_MEDIA_BASE_URL=https://your_storage_account.blob.core.windows.net/audiosen-product-media

# Private repair/audiogram quarantine storage. Enable Defender for Storage on-upload scanning.
AZURE_BLOB_SERVICE_URL=https://your_storage_account.blob.core.windows.net
AZURE_BLOB_CONTAINER=patient-upload-quarantine
AZURE_BLOB_CREATE_PRIVATE_CONTAINER=false
UPLOAD_SCAN_RESULT_MODE=defender-tags

# Exact origins/proxy headers depend on the production edge. Do not trust proxy headers by default.
# Private uploads fail closed in production unless one of these policies yields a trusted client IP.
ENQUIRY_ALLOWED_ORIGINS=https://audiosen.com,https://www.audiosen.com
TRUST_CLOUDFLARE_IP=false
TRUST_PROXY_HEADERS=false
